         max(CGFloat(Preferences.shared.dockHeight), contentCross())
     }
 
+    /// The normal window work area beside the *visible bar*, excluding the native
+    /// menu bar/Dock. The transparent panel's hover and animation room is not reserved.
+    func reservedUsableFrame(windowGap: CGFloat) -> CGRect? {
+        guard let screen = boundScreen, isVisible, !fullyHidden, !autoHideActive,
+              !fullscreenActive, hideState == .shown,
+              !isAnimating, !isReordering, !isExternalDragging,
+              let visible = screen.visibleFrameInCGCoordinates else { return nil }
+        layoutIfNeeded()
+        let prefs = Preferences.shared
+        let gap = CGFloat(prefs.edgeGap)
+        guard gap.isFinite, gap >= 0, windowGap.isFinite else { return nil }
+        let position = prefs.barPosition
+        var indicatorExtent: CGFloat = 0
+        if prefs.desktopIndicatorEnabled, prefs.desktopIndicatorPosition == .aboveDock,
+           desktopIndicator.superview === container, !desktopIndicator.isHidden {
+            let indicator = container.convert(desktopIndicator.bounds, from: desktopIndicator)
+            let bar = container.convert(effect.bounds, from: effect)
+            switch position {
+            case .bottom: indicatorExtent = max(0, indicator.maxY - bar.maxY)
+            case .top:    indicatorExtent = max(0, bar.minY - indicator.minY)
+            case .left:   indicatorExtent = max(0, indicator.maxX - bar.maxX)
+            case .right:  indicatorExtent = max(0, bar.minX - indicator.minX)
+            }
+        }
+        let depth = barThickness() + gap + min(max(windowGap, 0), 32) + indicatorExtent
+        guard depth.isFinite else { return nil }
+        let edge: ReservedDockGeometry.Edge
+        switch position {
+        case .bottom: edge = .bottom
+        case .top: edge = .top
+        case .left: edge = .left
+        case .right: edge = .right
+        }
+        return ReservedDockGeometry.usableBounds(from: visible, reserving: edge, depth: depth)
+    }
+
     /// Frames the blur to `barThickness` across and the full window length along
     /// its axis, pinned to the window's OUTER edge so any spare window room (hover
     /// headroom) sits on the inner side and the bar never overhangs the screen edge.
