--- a/Sources/SpaceKit/WindowAX.swift
+++ b/Sources/SpaceKit/WindowAX.swift
@@ -91,6 +91,45 @@ enum WindowAX {
         }
     }
 
+    /// Reservation-only write: avoid redundant attributes and let an oversized
+    /// window shrink before moving it into the smaller usable rectangle.
+    @discardableResult
+    static func setFrame(_ frame: CGRect, of window: AXUIElement, from current: CGRect) -> Bool {
+        guard frame.width <= current.width, frame.height <= current.height else { return false }
+        let move = frame.origin != current.origin
+        let resize = frame.size != current.size
+        guard move || resize else { return true }
+        if move && !isSettable(kAXPositionAttribute as CFString, of: window) { return false }
+        if resize && !isSettable(kAXSizeAttribute as CFString, of: window) { return false }
+        if resize {
+            var size = frame.size
+            guard let value = AXValueCreate(.cgSize, &size),
+                  AXUIElementSetAttributeValue(window, kAXSizeAttribute as CFString, value) == .success
+            else { return false }
+        }
+        if move {
+            var origin = frame.origin
+            guard let value = AXValueCreate(.cgPoint, &origin),
+                  AXUIElementSetAttributeValue(window, kAXPositionAttribute as CFString, value) == .success
+            else { return false }
+        }
+        return true
+    }
+
+    private static func isSettable(_ attribute: CFString, of window: AXUIElement) -> Bool {
+        var settable: DarwinBoolean = false
+        return AXUIElementIsAttributeSettable(window, attribute, &settable) == .success
+            && settable.boolValue
+    }
+
+    /// A live backstop for a full-screen transition between snapshot and AX read.
+    static func isFullscreen(_ window: AXUIElement) -> Bool {
+        var ref: CFTypeRef?
+        guard AXUIElementCopyAttributeValue(window, "AXFullScreen" as CFString, &ref) == .success,
+              let value = ref, CFGetTypeID(value) == CFBooleanGetTypeID() else { return false }
+        return CFBooleanGetValue((value as! CFBoolean))
+    }
+
     static func minimize(_ window: AXUIElement) {
         AXUIElementSetAttributeValue(window, kAXMinimizedAttribute as CFString, kCFBooleanTrue)
     }
