+    WindowInfo(windowID: id, pid: pid, ownerName: "Example", bundleID: "example.app",
+               spaceIDs: spaces, bounds: bounds, isOnscreen: onscreen,
+               isMinimized: minimized, isHidden: hidden)
+}
+func reservationCandidate(_ window: WindowInfo, display: CGRect = reservationDisplay,
+                          usable: CGRect = clearArea) -> Bool {
+    WindowReservation.isCandidate(window, displayBounds: display, usableBounds: usable,
+                                  excludingPID: 999)
+}
+h.test("snapshot candidate requires visible offending window on its display") {
+    h.ok(reservationCandidate(reservationWindow()))
+    h.ok(!reservationCandidate(reservationWindow(bounds: CGRect(x: 100, y: 100, width: 900, height: 600))))
+    h.ok(!reservationCandidate(reservationWindow(pid: 999)))
+    h.ok(!reservationCandidate(reservationWindow(pid: 0)))
+    h.ok(!reservationCandidate(reservationWindow(0)))
+    h.ok(!reservationCandidate(reservationWindow(onscreen: false)))
+    h.ok(!reservationCandidate(reservationWindow(minimized: true)))
+    h.ok(!reservationCandidate(reservationWindow(hidden: true)))
+    h.ok(!reservationCandidate(reservationWindow(onscreen: true, minimized: true, hidden: true)))
+    h.ok(!reservationCandidate(reservationWindow(bounds: .zero)))
+    h.ok(reservationCandidate(reservationWindow(spaces: [999])),
+         "other displays can show different Space IDs")
+}
+h.test("candidate display ownership uses center and half-open edges") {
+    let right = CGRect(x: 1200, y: 0, width: 1200, height: 800)
+    let rightUsable = CGRect(x: 1200, y: 24, width: 1200, height: 700)
+    let boundary = reservationWindow(bounds: CGRect(x: 1150, y: 700, width: 100, height: 100))
+    h.ok(!reservationCandidate(boundary), "center on maxX belongs to next display")
+    h.ok(reservationCandidate(boundary, display: right, usable: rightUsable))
+    let mostlyOnLeft = reservationWindow(bounds: CGRect(x: 1100, y: 700, width: 120, height: 100))
+    h.ok(!reservationCandidate(mostlyOnLeft, display: right, usable: rightUsable))
+    let above = CGRect(x: 0, y: -900, width: 1200, height: 900)
+    let aboveUsable = CGRect(x: 0, y: -876, width: 1200, height: 800)
+    h.ok(reservationCandidate(reservationWindow(bounds: CGRect(x: 100, y: -650, width: 900, height: 600)),
+                              display: above, usable: aboveUsable))
+    let below = CGRect(x: 0, y: 800, width: 1200, height: 900)
+    let belowUsable = CGRect(x: 0, y: 824, width: 1200, height: 800)
+    h.ok(reservationCandidate(reservationWindow(bounds: CGRect(x: 100, y: 1050, width: 900, height: 600)),
+                              display: below, usable: belowUsable))
+    h.ok(!reservationCandidate(reservationWindow(), usable: CGRect(x: 0, y: 0, width: 1201, height: 800)))
+}
+h.test("reservation limits AX correction to standard nonmodal windows") {
+    h.ok(WindowReservation.isOrdinaryWindow(role: "AXWindow", subrole: "AXStandardWindow", isModal: false))
+    let excludedKinds: [(String?, String?, Bool)] = [
+        ("AXSheet", nil, false), ("AXWindow", "AXDialog", false),
+        ("AXWindow", "AXSystemDialog", false), ("AXWindow", "AXFloatingWindow", false),
+        ("AXWindow", "AXUnknown", false), ("AXWindow", nil, false),
+        (nil, "AXStandardWindow", false), ("AXWindow", "AXStandardWindow", true),
+    ]
+    for (role, subrole, modal) in excludedKinds {
+        h.ok(!WindowReservation.isOrdinaryWindow(role: role, subrole: subrole, isModal: modal))
+    }
+}
+
